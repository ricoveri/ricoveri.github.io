---
import { site } from '../site';
const { current } = Astro.props as { current?: 'home' | 'gallery' };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="wrap bar">
  <a class="brand" href={`${base}/`}>{site.name}</a>
  <nav aria-label="Main" class="mono">
    <a href={`${base}/gallery/`} aria-current={current === 'gallery' ? 'page' : undefined}>Gallery</a>
    <a href={`${base}/#about`}>About</a>
    <a href={`${base}/#contact`}>Contact</a>
  </nav>
</header>
<style>
  .bar {
    padding-top: 32px;
    padding-bottom: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .brand {
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    font-size: 13px;
    letter-spacing: 0.06em;
  }
  nav a {
    text-decoration: none;
    padding: 12px 0;
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
</style>
